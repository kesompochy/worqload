{
  "name": "worqload",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "worqload": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "bun --watch src/cli.ts serve",
    "build": "bun build --compile src/cli.ts --outfile dist/worqload",
    "test": "bun test",
    "lint": "bunx @biomejs/biome lint src/",
    "format": "bunx @biomejs/biome format src/",
    "check": "bunx @biomejs/biome check src/",
    "check:fix": "bunx @biomejs/biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}

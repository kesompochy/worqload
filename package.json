{
  "name": "worqload",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "worqload": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "vite build --config ./vite.config.ts && bun --watch src/cli.ts serve --no-open",
    "preview": "vite build --config ./vite.config.ts && bun src/cli.ts preview",
    "web:build": "vite build --config ./vite.config.ts",
    "web:watch": "vite build --config ./vite.config.ts --watch",
    "archive:build": "vite build --config ./vite.archive.config.ts",
    "archive:watch": "vite build --config ./vite.archive.config.ts --watch",
    "build": "bun build --compile src/cli.ts --outfile dist/worqload",
    "test": "bun run test:small && bun run test:medium",
    "test:small": "find src web -name '*.small.test.ts' | xargs bun test",
    "test:medium": "find src web -name '*.test.ts' ! -name '*.small.test.ts' ! -name web-bundle.test.ts | xargs bun scripts/test-files.ts && bun test src/web-bundle.test.ts",
    "lint": "bunx @biomejs/biome lint src/",
    "format": "bunx @biomejs/biome format src/",
    "check": "bunx @biomejs/biome check src/",
    "check:fix": "bunx @biomejs/biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bun": "latest",
    "svelte": "^5.55.5",
    "vite": "^8.0.12"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "typescript-language-server": "^5.2.0"
  }
}
